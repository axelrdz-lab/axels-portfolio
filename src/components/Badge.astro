---
interface Props {
  class: string;
  fillColor?: string;
  bgColor?: string;
  text: string;
}

const { class : className, fillColor, bgColor, text } = Astro.props;
const finalFillColor = fillColor ?? 'fill-green-500'
const finalBgColor = `bg-container`
---

<div class:list={["py-1 px-2 flex flex-row gap-2 items-center", 
  "backdrop-blur-lg border border-border rounded-md",
  className, finalBgColor
]}>
  <svg class=`size-2 ${finalFillColor}` xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z"></path>
  </svg>
  <span class="text-xs font-geist-mono">{text}</span>
</div>