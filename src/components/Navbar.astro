---
import Sun from './icons/Sun.astro';
import Moon from './icons/Moon.astro';
import Translate from './icons/Translate.astro';
import IconButton from './buttons/IconButton.astro';

import { t, getLang } from '../i18n/utils'

const currentLang = getLang(Astro.currentLocale);
---

<nav class="w-full sticky top-3 z-50 backdrop-blur-lg transition">
  <ul class="
    flex items-center justify-center sm:justify-end gap-4 sm:gap-6 
    bg-container border border-border rounded-md py-4 px-4 sm:px-6
    text-sm sm:text-base
    transition-all duration-300
  ">
    <li class="hover:text-text-secondary transition-all duration-200">
      <a href="#home">{t(currentLang, 'navbar.home')}</a>
    </li>
    <li class="hover:text-text-secondary transition-all duration-200">
      <a href="#projects">{t(currentLang, 'navbar.projects')}</a>
    </li>
    <li class="hover:text-text-secondary transition-all duration-200">
      <a href="#experience">{t(currentLang, 'navbar.experience')}</a>
    </li>
    <li>
      <IconButton class='swap swap-rotate swap-active' data-theme-toggle>
        <Moon class="swap-on size-5" />
        <Sun class="swap-off size-5" />
      </IconButton>
    </li>
    <li class="border-l border-divider h-5"></li>
    <li>
      <IconButton targetBlank={false} data-language-toggle>
        <Translate id="icon-translate" class="size-5" />
      </IconButton>
    </li>
  </ul>
</nav>

<script>
  const themeButton = document.querySelector('[data-theme-toggle]')
  const langToggle = document.querySelector('[data-language-toggle]') as HTMLButtonElement

  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme)
    if (theme === 'dark') {
      themeButton?.classList.remove('swap-active')
    } else {
      themeButton?.classList.add('swap-active')
    }
  }
  
  langToggle?.addEventListener('click', () => {
    const currentLang = document.documentElement.lang || 'es'
    const hash = window.location.hash
    const next = currentLang === 'es' ? '/en/' : '/'
    window.location.replace(`${next}${hash}`)
  })

  themeButton?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme')
    const next = current === 'dark' ? 'light' : 'dark'
    localStorage.setItem('theme', next)
    applyTheme(next)
  })
  
  const saved = localStorage.getItem('theme') ?? 'dark'
  applyTheme(saved)
</script>