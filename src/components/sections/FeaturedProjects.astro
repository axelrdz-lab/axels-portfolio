---
import Section from './Section.astro';
import ProjectCard from '../ProjectCard.astro';

import { projects } from '../../data/projects.ts';
import { t, getLang } from '../../i18n/utils';

const currentLang = getLang(Astro.currentLocale)
---

<Section id="projects" title={t(currentLang, 'featuredProjects.title')}>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 transition-all duration-300">
    {
      projects.map(project => (
        <ProjectCard project={project} />
      ))
    }
  </div>
</Section>
