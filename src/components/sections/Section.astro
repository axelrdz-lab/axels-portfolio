---
const { class: className, gap = 'gap-6', title, ...rest } = Astro.props
---

<section class:list={["flex flex-col mx-4 md:mx-8 lg:mx-12 my-4 scroll-mt-32 z-2", gap, className]} {...rest}>
  {title && <div class="flex flex-col gap-2">
     <h2 class="text-3xl italic font-source-serif">{title}</h2>
    <div class="border-b border-dashed border-divider"></div>
  </div>}
  <slot />
</section>