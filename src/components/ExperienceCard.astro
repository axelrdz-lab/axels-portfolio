---
import ArrowDown from './icons/ArrowDown.astro';
import IconButton from './buttons/IconButton.astro';
import TooltipIcon from './TooltipIcon.astro';

import { getLang } from '../i18n/utils';

import { icons, type IconName } from './icons/techStack/techIndex';
import type { Job } from '../data/jobs';

interface Props {
  job: Job;
}

const { job } = Astro.props;
const currentLang = getLang(Astro.currentLocale);
const position = currentLang === 'es' ? job.position.es : job.position.en;
const description = currentLang === 'es' ? job.description.es : job.description.en;
---

<li class="flex flex-col gap-0 p-4 border border-border rounded-md bg-container">
  <!-- info inicial (puesto, empresa y año) -->
  <div class="flex flex-row items-center gap-4 w-full">
    <div class="flex flex-col gap-2 grow">
      <h3 class="text-lg/5">{position}</h3>
      <p class="-mt-1 text-sm/4 font-light text-text-secondary">{job.company}</p>
    </div>
    <time class="font-geist-mono text-text-secondary w-fit">{job.year}</time>
    <IconButton data-target={`content-${job.id}`}>
      <ArrowDown class="size-5 transition-all duration-200" />
    </IconButton>
  </div>
  <!-- ver mas (descripcio y stack) -->
  <div id={`content-${job.id}`} class="
    max-h-0 overflow-hidden
    flex flex-col gap-4
    transition-all duration-100
  ">
    <div class="border-b border-dashed border-divider pt-4"></div>
    <ul class="text-base/[22px] flex flex-col gap-1">
      {description.map(point => (
        <li class="text-sm flex gap-2 items-start">
          <span class="text-text-secondary m-0">▸</span>
          <span>{point}</span>
        </li>
      ))}
    </ul>
    <ul class="flex row gap-2">
      {job.techStack.map(technology => {
        const IconComponent = icons[technology.icon as IconName]
        const iconId = `${job.id}-${technology.name}`
        return (
          <TooltipIcon id={iconId} name={technology.name}>
            <IconComponent class="size-6" />
          </TooltipIcon>
        )
      })}
    </ul>
  </div>
</li>

<script>
  document.querySelectorAll('[data-target]').forEach(button => {

    button.addEventListener('click', () => {
      const target = button.getAttribute('data-target')
      if (!target) return
      const content = document.getElementById(target)
      const arrow = button.querySelector('svg')
      if (!content || !arrow) return

      if (content.style.maxHeight && content.style.maxHeight !== '0px') {
        content.style.maxHeight = '0px'
        arrow.style.transform = 'rotate(0deg)'
      } else {
        content.style.maxHeight = content.scrollHeight + 'px'
        arrow.style.transform = 'rotate(180deg)'
      }

    })
  })
</script>