---
import "../styles/global.css";
import openGraphImage from '../assets/images/opengraph.webp'

const currentLang = Astro.currentLocale || 'es'
---

<!doctype html>
<html lang={currentLang} data-theme="">

	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/new-favicon.png" />
		<link rel="icon" href="/new-favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Information Technology Engineer passionate about crafting creative and tailored accesible solutions." />
		<title>Axel Rodríguez - Web & Mobile Developer, UI/UX Designer ◝(^⌣^)◜</title>

		<meta property="og:title" content="Axel Rodríguez — Web & Mobile Developer, UI/UX Designer ◝(^⌣^)◜" />
		<meta property="og:description" content="Information Technology Engineer passionate about crafting creative and tailored accesible solutions." />
		<meta property="og:image" content="https://axels-portfolio-navy.vercel.app/images/opengraph.webp" />
		<meta property="og:url" content="https://axels-portfolio-navy.vercel.app" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Axel Rodríguez — Web & Mobile Developer, UI/UX Designer ◝(^⌣^)◜" />
		<meta name="twitter:description" content="Information Technology Engineer passionate about crafting creative and tailored accesible solutions." />
		<meta name="twitter:image" content="https://axels-portfolio-navy.vercel.app/images/opengraph.webp" />
	</head>

	<script is:inline>
		const saved = localStorage.getItem('theme')
	  const systemPreference = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'dark'
		const theme = saved ?? systemPreference
		document.documentElement.setAttribute('data-theme', theme)
	</script>

	<body class="
		font-geist
		text-mist-50
		selection:bg-pinkpantheress-500/80
	">
		<slot />
	</body>

</html>

<style>
	html {
		scroll-behavior: smooth;
	}
	html,
	body {
		background-color: var(--bg-color);
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
